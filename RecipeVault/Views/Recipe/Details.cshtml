@model RecipeVault.ViewModels.Recipe.RecipeDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded shadow" />
        }
    </div>
    <div class="col-md-7">
        <h1>@Model.Title</h1>
        <p>
            <span class="badge bg-secondary">@Model.CuisineName</span>
            <span class="badge bg-info text-dark">@Model.Difficulty</span>
            <span class="badge bg-light text-dark">@Model.PrepTimeMinutes min</span>
            <span class="badge bg-light text-dark">@Model.Servings servings</span>
        </p>
        <p class="lead">@Model.Description</p>
        <p class="text-muted">Added on @Model.CreatedOn.ToString("d MMM yyyy")</p>

        <h4>Ingredients</h4>
        @if (Model.Ingredients.Any())
        {
            <ul>
                @foreach (var ingredient in Model.Ingredients)
                {
                    <li>@ingredient</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted">No ingredients listed yet.</p>
        }

        <h4>Instructions</h4>
        <p style="white-space: pre-line;">@Model.Instructions</p>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-secondary">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to all</a>
    </div>
</div>

<hr class="my-5" />

<section class="row">
    <div class="col-lg-7">
        <h3 class="mb-1">Reviews</h3>
        @if (Model.Reviews.Any())
        {
            var fullStars = (int)Math.Round(Model.AverageRating);
            <p class="mb-4">
                <span class="stars fs-5">@(new string('★', fullStars))@(new string('☆', 5 - fullStars))</span>
                <span class="text-muted">@Model.AverageRating.ToString("0.0") out of 5 · @Model.Reviews.Count review@(Model.Reviews.Count == 1 ? "" : "s")</span>
            </p>

            foreach (var review in Model.Reviews)
            {
                <div class="review-item mb-3">
                    <div class="d-flex justify-content-between">
                        <strong>@review.AuthorName</strong>
                        <span class="text-muted small">@review.CreatedOn.ToString("d MMM yyyy")</span>
                    </div>
                    <span class="stars">@(new string('★', review.Rating))@(new string('☆', 5 - review.Rating))</span>
                    @if (!string.IsNullOrEmpty(review.Comment))
                    {
                        <p class="mb-0 mt-1">@review.Comment</p>
                    }
                </div>
            }
        }
        else
        {
            <p class="text-muted mb-4">No reviews yet — be the first to rate this recipe!</p>
        }
    </div>

    <div class="col-lg-5">
        <div class="card p-3">
            <h5>Leave a review</h5>
            @if (TempData["ReviewError"] != null)
            {
                <div class="alert alert-danger py-2">@TempData["ReviewError"]</div>
            }
            <form asp-action="AddReview" method="post">
                <input type="hidden" name="RecipeId" value="@Model.Id" />
                <div class="mb-2">
                    <label class="form-label" for="AuthorName">Your name</label>
                    <input class="form-control" id="AuthorName" name="AuthorName" required minlength="2" maxlength="50" />
                </div>
                <div class="mb-2">
                    <label class="form-label" for="Rating">Rating</label>
                    <select class="form-select" id="Rating" name="Rating">
                        <option value="5">★★★★★ — Excellent</option>
                        <option value="4">★★★★☆ — Very good</option>
                        <option value="3">★★★☆☆ — Average</option>
                        <option value="2">★★☆☆☆ — Poor</option>
                        <option value="1">★☆☆☆☆ — Terrible</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Comment">Comment (optional)</label>
                    <textarea class="form-control" id="Comment" name="Comment" rows="3" maxlength="1000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary w-100">Post review</button>
            </form>
        </div>
    </div>
</section>
