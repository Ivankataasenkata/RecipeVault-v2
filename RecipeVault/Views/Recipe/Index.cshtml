@model IEnumerable<RecipeVault.ViewModels.Recipe.RecipeAllViewModel>
@{
    ViewData["Title"] = "All Recipes";
}

<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
    <div>
        <h1 class="mb-1">All Recipes</h1>
        <p class="text-muted mb-0">@Model.Count() recipe@(Model.Count() == 1 ? "" : "s") in the vault</p>
    </div>
    <a asp-action="Create" class="btn btn-success">+ Add Recipe</a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <div style="font-size: 4rem;">🍳</div>
        <h4 class="mt-3">No recipes yet</h4>
        <p class="text-muted">Be the first to add one!</p>
        <a asp-action="Create" class="btn btn-success">Add the first recipe</a>
    </div>
}

<div class="row g-4">
    @foreach (var recipe in Model)
    {
        var difficultyClass = recipe.Difficulty switch
        {
            "Easy" => "text-bg-success",
            "Medium" => "text-bg-warning",
            "Hard" => "text-bg-danger",
            _ => "text-bg-secondary"
        };

        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 recipe-card">
                <div class="recipe-img-wrap">
                    @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                    {
                        <img src="@recipe.ImageUrl" class="recipe-img" alt="@recipe.Title" loading="lazy">
                    }
                    else
                    {
                        <div class="recipe-img-placeholder">🍽️</div>
                    }
                    <span class="badge @difficultyClass recipe-difficulty">@recipe.Difficulty</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-2">@recipe.Title</h5>
                    <p class="card-text text-muted small mb-3">
                        <span class="me-3">🌍 @recipe.CuisineName</span>
                        <span>⏱ @recipe.PrepTimeMinutes min</span>
                    </p>
                    <div class="mt-auto d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-primary btn-sm flex-grow-1">View recipe</a>
                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-outline-secondary btn-sm" title="Edit">✏️</a>
                        <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-outline-danger btn-sm" title="Delete">🗑</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
