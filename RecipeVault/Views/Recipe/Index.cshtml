@model IEnumerable<RecipeVault.ViewModels.Recipe.RecipeAllViewModel>
@{
    ViewData["Title"] = "All Recipes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>All Recipes</h1>
    <a asp-action="Create" class="btn btn-primary">+ Add Recipe</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No recipes yet. Be the first to add one!</div>
}

<div class="row">
    @foreach (var recipe in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(recipe.ImageUrl))
                {
                    <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Title"
                         style="height: 200px; object-fit: cover;">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@recipe.Title</h5>
                    <p class="card-text">
                        <span class="badge bg-secondary">@recipe.CuisineName</span>
                        <span class="badge bg-info text-dark">@recipe.Difficulty</span>
                        <span class="badge bg-light text-dark">@recipe.PrepTimeMinutes min</span>
                    </p>
                    <div class="mt-auto">
                        <a asp-action="Details" asp-route-id="@recipe.Id" class="btn btn-outline-primary btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@recipe.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@recipe.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
